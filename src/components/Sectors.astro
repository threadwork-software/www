---
import { Icon } from 'astro-icon/components';

import Section from '~/components/Section.astro';

const sectors = [
  {
    icon: 'tabler:briefcase',
    title: 'Private sector',
    body: 'Employers who carry a training obligation for their own workforce, and vendors who deliver training to somebody else',
  },
  {
    icon: 'tabler:building-bank',
    title: 'Public sector',
    body: 'Government departments and agencies, where the record of who was trained is part of the public accountability',
  },
  {
    icon: 'tabler:users-group',
    title: 'Non-profit associations',
    body: 'Professional bodies that certify members and have to show that continuing education actually happened',
  },
];

const functions = [
  'Training and learning',
  'Professional development',
  'Regulatory compliance',
  'Human resources',
  'Health, safety, and environment',
  'OSHA and occupational safety',
];
---

<Section
  id="clients"
  eyebrow="Who we work with"
  title="The department, not the org chart"
  lead="Our clients have ranged from small teams to large organizations across three sectors. What they have in common is not size. It is a function inside the organization that has to prove people were trained."
  class="bg-slate-50 dark:bg-slate-900/40"
>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      sectors.map((sector) => (
        <article class="rounded-xl border border-slate-200 bg-white p-7 dark:border-slate-800 dark:bg-slate-950/60">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-soft text-brand dark:bg-brand/20 dark:text-brand-light">
            <Icon name={sector.icon} class="h-5 w-5" aria-hidden="true" />
          </span>
          <h3 class="mt-5 text-lg font-semibold text-slate-900 dark:text-white">{sector.title}</h3>
          <p class="mt-2.5 leading-relaxed text-slate-600 dark:text-slate-400">{sector.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-12 rounded-xl border border-slate-200 bg-white p-7 md:p-9 dark:border-slate-800 dark:bg-slate-950/60">
    <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Where our work is done</h3>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      The teams that hire us usually have one of these mandates, and often several at once.
    </p>
    <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        functions.map((item) => (
          <li class="flex items-start gap-2.5 text-slate-700 dark:text-slate-300">
            <Icon
              name="tabler:point-filled"
              class="mt-1.5 h-4 w-4 shrink-0 text-brand dark:text-brand-light"
              aria-hidden="true"
            />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
