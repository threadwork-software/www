---
import { Icon } from 'astro-icon/components';

import { NAV, PRODUCT, SITE } from '~/config';
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md dark:border-slate-800 dark:bg-slate-950/90"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 md:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-brand text-white">
        <Icon name="tabler:needle-thread" class="h-5 w-5" aria-hidden="true" />
      </span>
      <span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-slate-600 transition hover:text-brand dark:text-slate-400 dark:hover:text-brand-light"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={PRODUCT.url}
        class="hidden items-center gap-1.5 rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-hover sm:inline-flex"
      >
        Visit {PRODUCT.name}
        <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-slate-600 transition hover:bg-slate-100 lg:hidden dark:text-slate-400 dark:hover:bg-slate-800"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <Icon name="tabler:menu-2" class="h-6 w-6" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    id="nav-mobile"
    class="hidden border-t border-slate-200 px-5 pb-4 lg:hidden dark:border-slate-800"
    aria-label="Main, mobile"
  >
    <ul class="flex flex-col py-2">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-2 py-2.5 text-base font-medium text-slate-700 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={PRODUCT.url}
          class="block rounded-md px-2 py-2.5 text-base font-medium text-brand dark:text-brand-light"
        >
          Visit {PRODUCT.name}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
    }
  });
</script>
