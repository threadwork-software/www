---
import { Icon } from 'astro-icon/components';

import { ENTITY, METADATA, PRODUCT, SITE } from '~/config';

// BROAD READING of OQ-458 ruling 1: this page no longer leans on the
// incorporation date as a narrative. The approved OQ-423 fact list is entity
// name, jurisdiction, registration number, named founders, and public AGPL
// code, so the badge carries the jurisdiction and the registry number instead
// of the founding year.
//
// The year is not hidden. It stays in the Verify block as a record to look up,
// which is the checkability the ruling was protecting. What goes is the claim
// built on top of it, and with it the `years` arithmetic this file used to do.
//
// The headline reuses the tagline half of the approved page title rather than
// new copy, so nothing here asserts anything the site did not already say.
const headline = METADATA.title.includes(':')
  ? METADATA.title.slice(METADATA.title.indexOf(':') + 1).trim()
  : METADATA.title;
---

<section class="relative overflow-hidden border-b border-slate-200 dark:border-slate-800">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-brand-soft/60 via-white to-white dark:from-brand-deep/40 dark:via-slate-950 dark:to-slate-950"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-brand/25 bg-white/70 px-3.5 py-1.5 text-sm font-medium text-brand dark:border-brand-light/25 dark:bg-slate-900/70 dark:text-brand-light"
    >
      <Icon name="tabler:building-arch" class="h-4 w-4" aria-hidden="true" />
      {ENTITY.jurisdiction} · {ENTITY.registryLabel}
      {ENTITY.registryNumber}
    </p>

    <h1
      class="mt-7 max-w-4xl text-4xl font-bold leading-tight tracking-tight text-slate-900 md:text-6xl dark:text-white"
    >
      {headline}
    </h1>

    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl dark:text-slate-400">
      {SITE.legalName} is a Canadian IT consultancy. Our work concentrates in one domain: training and education. In {
        PRODUCT.launchDate
      } we launched {PRODUCT.name}, built on everything that came before it.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#what-we-do"
        class="inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 text-base font-semibold text-white transition hover:bg-brand-hover"
      >
        What we do
        <Icon name="tabler:arrow-down" class="h-4 w-4" aria-hidden="true" />
      </a>
      <a
        href={PRODUCT.url}
        class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-6 py-3 text-base font-semibold text-slate-800 transition hover:border-slate-500 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:border-slate-500 dark:hover:bg-slate-900"
      >
        Visit {PRODUCT.name}
        <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>

    <p class="mt-8">
      <a
        href="#verify"
        class="inline-flex items-center gap-2 text-base font-medium text-brand underline decoration-brand/30 underline-offset-4 transition hover:decoration-brand dark:text-brand-light dark:decoration-brand-light/30 dark:hover:decoration-brand-light"
      >
        <Icon name="tabler:shield-check" class="h-5 w-5" aria-hidden="true" />
        Checking us out? Here is the company of record
      </a>
    </p>
  </div>
</section>
