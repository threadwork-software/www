---
import Section from '~/components/Section.astro';

import { ENTITY, PRODUCT, SITE } from '~/config';

const milestones = [
  {
    date: ENTITY.incorporated,
    title: 'The company is incorporated in Alberta, Canada',
    body: 'Formed to do consulting work for organizations that deliver training. This is the incorporation date the corporate register still carries today, in case your due diligence requires it.',
  },
  {
    date: '2006 to 2025',
    title: 'Two decades of consulting',
    body: 'Twenty years of client work across private employers, government departments, and professional associations. Different clients, one recurring problem: delivering training content to learners and tracking a defensible record of competencies and certifications.',
  },
  {
    date: PRODUCT.betaDate,
    title: `${PRODUCT.name} enters private beta`,
    body: 'We released the platform to a small, selected group of existing clients. Real courses, real learners, real compliance deadlines. We knew we could deliver SCORM content better and more cost-effectively than other vendors, and our clients trusted us enough to allow us the opportunity to prove it.',
  },
  {
    date: 'August 2025 to December 2025',
    title: 'Refinement on pilot feedback',
    body: 'Five months of improvements driven by what the pilot group encountered in practice, rather than by a roadmap written in advance.',
  },
  {
    date: 'January 2026',
    title: `The company adopts the name ${SITE.name}`,
    body: `We registered the domain threadworksoftware.com and renamed the company to match the work it now does. The company is the same (only the name changed) so you can confirm our 2006 incorporation date if proven longevity is part of your procurement due diligence.`,
  },
  {
    date: 'February 2026 to June 2026',
    title: 'Ongoing refinement on pilot feedback',
    body: 'Another five months of platform improvements driven by a growing list of organizations joining the pilot (more than a hundred by the end of June).',
  },
  {
    date: PRODUCT.launchDate,
    title: `${PRODUCT.name} launches globally`,
    body: `General availability, announced publicly, with its own site at ${PRODUCT.url.replace('https://', '')}.`,
  },
];
---

<Section
  id="history"
  eyebrow="History"
  title={`From ${SITE.foundingDate} to a shipped product`}
  lead="These days, a product is easy to launch, but it is not always easy to stand behind. Our company has a long and proven track record, so you can rest assured the company will still be here when your next audit comes due."
>
  <ol class="mt-12 space-y-0">
    {
      milestones.map((milestone, index) => (
        <li class="relative grid grid-cols-[auto_1fr] gap-x-5 pb-10 last:pb-0 md:grid-cols-[10rem_auto_1fr] md:gap-x-8">
          <p class="hidden pt-0.5 text-right font-semibold text-slate-900 md:block dark:text-white">{milestone.date}</p>

          <div class="flex flex-col items-center">
            <span class="mt-1 h-3.5 w-3.5 shrink-0 rounded-full bg-brand ring-4 ring-brand-soft dark:ring-brand/25" />
            {index < milestones.length - 1 && <span class="mt-1 w-px grow bg-slate-200 dark:bg-slate-800" />}
          </div>

          <div>
            <p class="font-semibold text-brand md:hidden dark:text-brand-light">{milestone.date}</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-900 md:mt-0 dark:text-white">{milestone.title}</h3>
            <p class="mt-2 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-400">{milestone.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
