---
import Section from '~/components/Section.astro';

import { ENTITY, PRODUCT } from '~/config';

// BROAD READING of OQ-458 ruling 1: this section is the product record rather
// than a duration story. Two milestones came out, both of which existed to count
// years rather than to say what was built: the 2006 incorporation entry and the
// "Two decades of consulting" entry. The incorporation date stays in the Verify
// block, where it is a record to look up instead of a claim to accept.
//
// What replaces them states the capability the consulting work produced without
// attaching a number of years to it, because the recurring problem is the part
// that explains why the product exists.
const milestones = [
  {
    date: 'Consulting practice',
    title: 'Client work across private employers, government, and associations',
    body: 'Different clients, one recurring problem: getting training content to learners and getting a defensible record back. OpenSCORM is the response to that problem rather than a change of direction.',
  },
  {
    date: PRODUCT.betaDate,
    title: `${PRODUCT.name} enters private beta`,
    body: 'We released the platform to a small, selected group of existing clients. Real courses, real learners, real compliance deadlines, on the understanding that it was early.',
  },
  {
    date: 'Late 2025 through mid 2026',
    title: 'Refinement on pilot feedback',
    body: 'Twelve months of changes driven by what the pilot group hit in practice rather than by a roadmap written in advance.',
  },
  {
    date: ENTITY.renamedOnLabel,
    title: 'The company adopts the Threadwork Software name',
    // The rename disclosure stays: it is the answer to a WHOIS on a 2026 domain,
    // and DEC-320 ruling 3b put that objection on the page deliberately. What
    // drops is the "younger than the business by twenty years" clause, which was
    // the duration claim rather than the disclosure.
    body: `A name change to the existing corporation, not a new company: the same registration and the same incorporation date carry forward unchanged. threadworksoftware.com was registered eight days earlier, which is why the domain is younger than the corporation.`,
  },
  {
    date: PRODUCT.launchDate,
    title: `${PRODUCT.name} launches globally`,
    body: `General availability, announced publicly, with its own site at ${PRODUCT.url.replace('https://', '')}.`,
  },
];
---

<Section
  id="history"
  eyebrow="History"
  title="How OpenSCORM got here"
  lead="A product is easy to launch and hard to stand behind. This is the record of what was built and when, because that is the part you can check against the product in front of you."
>
  <ol class="mt-12 space-y-0">
    {
      milestones.map((milestone, index) => (
        <li class="relative grid grid-cols-[auto_1fr] gap-x-5 pb-10 last:pb-0 md:grid-cols-[10rem_auto_1fr] md:gap-x-8">
          <p class="hidden pt-0.5 text-right font-semibold text-slate-900 md:block dark:text-white">{milestone.date}</p>

          <div class="flex flex-col items-center">
            <span class="mt-1 h-3.5 w-3.5 shrink-0 rounded-full bg-brand ring-4 ring-brand-soft dark:ring-brand/25" />
            {index < milestones.length - 1 && <span class="mt-1 w-px grow bg-slate-200 dark:bg-slate-800" />}
          </div>

          <div>
            <p class="font-semibold text-brand md:hidden dark:text-brand-light">{milestone.date}</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-900 md:mt-0 dark:text-white">{milestone.title}</h3>
            <p class="mt-2 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-400">{milestone.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
