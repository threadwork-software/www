---
import { Icon } from 'astro-icon/components';

import Section from '~/components/Section.astro';

import { ENTITY, PROVENANCE_FAQ, SITE } from '~/config';

/**
 * The registry row only renders when there is a real number to print. A visible
 * placeholder here would do more damage than leaving it out, since this is the
 * one block a skeptical reader is reading closely.
 */
const facts = [
  { term: 'Legal entity', value: SITE.legalName, mono: true },
  { term: 'Jurisdiction', value: ENTITY.jurisdiction, mono: false },
  { term: 'Incorporated', value: ENTITY.incorporatedIso, mono: true },
  { term: 'Register', value: ENTITY.registryAuthority, mono: false },
  ...(ENTITY.registryNumber ? [{ term: ENTITY.registryLabel, value: ENTITY.registryNumber, mono: true }] : []),
  { term: 'Current name adopted', value: ENTITY.renamedOnIso, mono: true },
];
---

<Section
  id="verify"
  eyebrow="Verify"
  title="How to check this for yourself"
  lead="Any claim a company makes about itself is worth exactly as much as your ability to confirm it. So here is the entity, and here is what to look up."
  class="bg-slate-50 dark:bg-slate-900/40"
>
  <div class="mt-12 grid gap-6 lg:grid-cols-5">
    <div
      class="self-start rounded-xl border border-slate-200 bg-white p-7 lg:col-span-2 dark:border-slate-800 dark:bg-slate-950/60"
    >
      <h3 class="flex items-center gap-2.5 text-lg font-semibold text-slate-900 dark:text-white">
        <Icon name="tabler:certificate" class="h-5 w-5 text-brand dark:text-brand-light" aria-hidden="true" />
        Company of record
      </h3>

      <dl class="mt-6 space-y-4">
        {
          facts.map((fact) => (
            <div class="border-b border-slate-100 pb-4 last:border-0 last:pb-0 dark:border-slate-800/70">
              <dt class="text-sm text-slate-500 dark:text-slate-500">{fact.term}</dt>
              <dd class:list={['mt-0.5 text-slate-900 dark:text-white', fact.mono ? 'font-mono' : 'font-medium']}>
                {fact.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 text-sm leading-relaxed text-slate-500 dark:text-slate-500">
        Search the company name above in the {ENTITY.registryAuthority} to confirm the incorporation date.
      </p>
    </div>

    <div class="space-y-5 lg:col-span-3">
      {
        PROVENANCE_FAQ.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-7 dark:border-slate-800 dark:bg-slate-950/60">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{item.question}</h3>
            <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-400">{item.answer}</p>
          </article>
        ))
      }
    </div>
  </div>
</Section>
