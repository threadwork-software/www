---
import Layout from '~/layouts/Layout.astro';

import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

import { SITE } from '~/config';
---

<Layout title={`Page not found | ${SITE.name}`} noindex={true}>
  <Header />

  <main id="main" class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-32">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand dark:text-brand-light">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-white">Page not found</h1>
    <p class="mt-5 max-w-xl text-lg text-slate-600 dark:text-slate-400">
      This site is a single page, so whatever you were looking for is either on the home page or somewhere else
      entirely.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 text-base font-semibold text-white transition hover:bg-brand-hover"
    >
      Back to the home page
    </a>
  </main>

  <Footer />
</Layout>
