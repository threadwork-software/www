---
import Layout from '~/layouts/Layout.astro';

import Header from '~/components/Header.astro';
import Hero from '~/components/Hero.astro';
import WhatWeDo from '~/components/WhatWeDo.astro';
import Sectors from '~/components/Sectors.astro';
import Timeline from '~/components/Timeline.astro';
import Provenance from '~/components/Provenance.astro';
import Product from '~/components/Product.astro';
import Contact from '~/components/Contact.astro';
import Footer from '~/components/Footer.astro';

import { ENTITY, PRODUCT, PROVENANCE_FAQ, SITE } from '~/config';

/**
 * foundingDate plus a jurisdiction plus a register identifier is what makes the
 * 2006 claim machine-checkable. An agent that only reads WHOIS sees a 2026
 * domain; this is where it finds the entity to look up instead.
 */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  foundingDate: ENTITY.incorporatedIso,
  foundingLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressRegion: ENTITY.jurisdictionRegion,
      addressCountry: ENTITY.jurisdictionCountry,
    },
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: ENTITY.jurisdictionRegion,
    addressCountry: ENTITY.jurisdictionCountry,
  },
  description:
    'Canadian IT consultancy incorporated in Alberta in 2006, working with training, education, and regulatory compliance departments. Developer and operator of OpenSCORM.',
  email: SITE.email,
  sameAs: [PRODUCT.url],
  ...(ENTITY.registryNumber
    ? {
        identifier: {
          '@type': 'PropertyValue',
          name: ENTITY.registryLabel,
          value: ENTITY.registryNumber,
        },
      }
    : {}),
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'SoftwareApplication',
      name: PRODUCT.name,
      url: PRODUCT.url,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
    },
  },
};

// Same source array the Verify section renders, so the visible answers and the
// structured data cannot drift apart.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PROVENANCE_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <Header />

  <main id="main">
    <Hero />
    <WhatWeDo />
    <Sectors />
    <Timeline />
    <Provenance />
    <Product />
    <Contact />
  </main>

  <Footer />
</Layout>
